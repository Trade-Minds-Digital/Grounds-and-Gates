# ====================================================================
# Grounds & Gates — Full-Stack MERN Environment Configuration
# ====================================================================

# ── Frontend Environment ───────────────────────────────────────────
VITE_API_URL="http://localhost:5000/api/v1"

# Firebase Authentication (Client Web App)
# In Firebase Console: Project settings > General > Your apps > Web app (</>)
VITE_FIREBASE_API_KEY="AIzaSyDummyKey_GroundsAndGates2026"
VITE_FIREBASE_AUTH_DOMAIN="grounds-and-gates.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="grounds-and-gates"
VITE_FIREBASE_STORAGE_BUCKET="grounds-and-gates.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# Geoapify Client API Key (Leaflet vector tiles, map markers)
# Free tier: 3,000 requests/day at https://myprojects.geoapify.com
# For production: Restrict this key to your browser domain (e.g., http://localhost:3000/*, https://groundsandgates.com/*)
VITE_GEOAPIFY_API_KEY=""

# GEMINI_API_KEY: AI Assistant for property search & recommendation
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Base host URL
APP_URL="http://localhost:3000"

# ── Backend Environment ────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL="http://localhost:3000"

# MongoDB Database Connection
# If MongoDB is not running locally, the server automatically boots an
# embedded in-memory MongoDB instance for seamless zero-config local development.
MONGODB_URI="mongodb://127.0.0.1:27017/grounds-and-gates"

# Firebase Admin SDK (Server Service Account)
# In Firebase Console: Project settings > Service accounts > Generate new private key
# Or set individual variables below (never commit private keys):
FIREBASE_PROJECT_ID="grounds-and-gates"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-fbsvc@grounds-and-gates.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
# Optional: Path to serviceAccountKey.json
# GOOGLE_APPLICATION_CREDENTIALS="./serviceAccountKey.json"
# Optional: Local Firebase Auth Emulator Host (e.g. 127.0.0.1:9099)
# FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"

# JWT Authentication
JWT_SECRET="groundsandgates-super-secure-production-jwt-secret-key-2026"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="groundsandgates-super-secure-production-refresh-secret-key-2026"
JWT_REFRESH_EXPIRES_IN="7d"

# Security & Cookies
COOKIE_SECRET="groundsandgates-cookie-parser-secret-2026"

# Geoapify Backend Provider Key (Optional separate key for server proxy calls: Places, Routing, Geocoding)
# If your client key is restricted by Browser HTTP Referrer, use a separate unrestricted or IP-restricted key here.
GEOAPIFY_API_KEY=""

# File Uploads Directory (Relative to server or absolute path)
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760
