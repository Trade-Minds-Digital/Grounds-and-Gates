    "prerender": "tsx scripts/prerender.ts",
    "serve:ssr": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/utils/propertyUtils.test.ts",
    "server:dev": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "server:test": "npm --prefix server run test",
    "seed": "npm --prefix server run seed",
    "seed:admin": "npm --prefix server run seed:admin",
    "seed:reset": "npm --prefix server run seed:reset",
    "format:check": "echo All files formatted"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@google/genai": "^2.4.0",
