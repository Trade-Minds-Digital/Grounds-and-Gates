    "@mui/material": "^9.5.0",
    "@mui/x-data-grid": "^9.17.0",
    "@mui/x-date-pickers": "^9.17.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
