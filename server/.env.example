# Server Port & Runtime
PORT=5000
NODE_ENV=development
CLIENT_URL="http://localhost:3000"

# MongoDB Database Connection
# If MongoDB is not running locally, the server automatically boots an
# embedded in-memory MongoDB instance for seamless zero-config local development.
MONGODB_URI="mongodb://127.0.0.1:27017/grounds-and-gates"

# JWT Authentication
JWT_SECRET="groundsandgates-super-secure-production-jwt-secret-key-2026"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="groundsandgates-super-secure-production-refresh-secret-key-2026"
JWT_REFRESH_EXPIRES_IN="7d"

# Security & Cookies
COOKIE_SECRET="groundsandgates-cookie-parser-secret-2026"

# File Uploads Directory
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760
